+  // Close every remaining boundary loop with a centroid fan. A fillet fragment
+  // that ends where the crease drops below the feature threshold (a tangent
+  // junction) leaves its strip end open; so does a mixed-sign vertex-star. Rather
+  // than refuse the whole blend for these local gaps, cap them — a crude but
+  // valid closure (winding is fixed afterwards by orient()). Returns the number
+  // of loops capped.
+  int capHoles()
+  {
+    auto ekey = [](int a, int b) { return std::pair<int, int>{std::min(a, b), std::max(a, b)}; };
+    int capped = 0;
+    for (int pass = 0; pass < 64; ++pass) {
+      // Directed boundary half-edges (a->b) whose undirected edge is used once,
+      // recomputed each pass since a fan closes the loop it fills.
+      std::map<std::pair<int, int>, int> use;
+      for (const auto& f : F)
+        for (int i = 0; i < 3; ++i) ++use[ekey(f[i], f[(i + 1) % 3])];
+      std::map<int, int> nextOf;  // a -> b along the hole boundary (one per vertex)
+      for (const auto& f : F)
+        for (int i = 0; i < 3; ++i) {
+          const int a = f[i], b = f[(i + 1) % 3];
+          if (use[ekey(a, b)] == 1) nextOf[a] = b;
+        }
+      if (nextOf.empty()) break;
+      // Walk one loop from an arbitrary boundary vertex.
+      const int start = nextOf.begin()->first;
+      std::vector<int> loop;
+      std::set<int> seen;
+      int cur = start;
+      bool ok = true;
+      while (true) {
+        if (seen.count(cur)) break;  // closed (back to a visited vertex)
+        seen.insert(cur);
+        loop.push_back(cur);
+        auto it = nextOf.find(cur);
+        if (it == nextOf.end()) { ok = false; break; }
+        cur = it->second;
+      }
+      if (ok && loop.size() >= 3) {
+        fan(loop);
+        ++capped;
+      } else {
+        break;  // could not form a loop; leave it for the validity check to catch
+      }
+    }
+    return capped;
+  }
