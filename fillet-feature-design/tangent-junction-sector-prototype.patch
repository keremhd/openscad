+  // One local face-side of a crease at vertex u: the fan sector containing a
+  // given incident triangle, i.e. the run of triangles reachable from it around
+  // u without crossing a feature edge, bounded by the two feature edges at its
+  // ends. This is the side a fillet arc actually seats against — and it is LOCAL,
+  // so it stays correct where smoothSurfaces merged the two sides of a fold into
+  // one global surface (a tangent junction, where the crease dihedral dips below
+  // the feature threshold somewhere else on the loop). `xb`/`xf` are the bounding
+  // feature edges' far vertices; `tb`/`tf` the sector triangles incident to them
+  // (for perpInto's orientation); `navg` the sector's averaged outward normal.
+  struct Sector
+  {
+    int xb, xf, tb, tf;
+    Vector3d navg;
+  };
+  std::optional<Sector> sectorOf(int u, int t) const
+  {
+    const std::vector<std::pair<int, int>> fan = fanAround(u);
+    const int n = static_cast<int>(fan.size());
+    if (n == 0) return std::nullopt;
+    int i = -1;
+    for (int k = 0; k < n; ++k)
+      if (fan[k].first == t) { i = k; break; }
+    if (i < 0) return std::nullopt;
+    auto isFeat = [&](int via) {
+      return feature.count({std::min(u, via), std::max(u, via)}) > 0;
+    };
+    // fan[k].second is the edge (u, via) between triangle k and k+1.
+    int f = i, steps = 0;
+    while (!isFeat(fan[f].second) && steps < n) { f = (f + 1) % n; ++steps; }
+    if (steps >= n) return std::nullopt;  // no feature edge in this fan
+    int b = i;
+    steps = 0;
+    while (!isFeat(fan[(b - 1 + n) % n].second) && steps < n) { b = (b - 1 + n) % n; ++steps; }
+    Sector s;
+    s.xf = fan[f].second;
+    s.tf = fan[f].first;
+    s.xb = fan[(b - 1 + n) % n].second;
+    s.tb = fan[b].first;
+    // Average the outward normals of the sector's triangles (b..f, cyclic), so a
+    // smooth curved crease gives every edge on it the same seat normal at u — the
+    // adjacent strips then share this cross-section and close without a gap.
+    Vector3d nsum = Vector3d::Zero();
+    for (int k = b;; k = (k + 1) % n) {
+      nsum += m.tris[fan[k].first].normal;
+      if (k == f) break;
+    }
+    s.navg = nsum.norm() > 1e-12 ? Vector3d(nsum.normalized()) : m.tris[t].normal;
+    return s;
+  }
