+    pts.reserve(arcSegs + 1);
+    for (int j = 0; j <= arcSegs; ++j) {
+      const double a = ang * j / arcSegs;
+      const Vector3d rot = ra * std::cos(a) + axis.cross(ra) * std::sin(a);
+      const double rad = la + (lb - la) * j / arcSegs;
+      pts.push_back(C + rad * rot);
+    }
+    return pts;
+  }
