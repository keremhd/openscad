fillet($fn = 32, $fa = 12, $fs = 2, r = 2) {
	group() {
		cube(size = [24, 24, 4], center = true);
		cylinder($fn = 32, $fa = 12, $fs = 2, h = 10, r1 = 5, r2 = 5, center = false);
	}
}
